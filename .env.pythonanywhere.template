# ══════════════════════════════════════════════════════════════════════════════
# PythonAnywhere Production Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════
# 
# Instructions:
# 1. Copy this file to .env on PythonAnywhere server
# 2. Replace all YOUR_* placeholders with actual values
# 3. Generate a strong SECRET_KEY (use: python -c "import secrets; print(secrets.token_hex(32))")
# 4. Never commit this file with real credentials to version control
#

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=YOUR_STRONG_SECRET_KEY_HERE_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# ── Database (PostgreSQL - Paid Account) ──────────────────────────────────────
# Get these from PythonAnywhere → Databases tab after creating PostgreSQL database
DATABASE_URL=postgresql://YOUR_PA_USERNAME:YOUR_DB_PASSWORD@YOUR_PA_USERNAME-XXXXX.postgres.pythonanywhere-services.com/YOUR_DB_NAME

# ── OR Database (SQLite - Free Account) ───────────────────────────────────────
# Uncomment this line and comment out PostgreSQL line above if using free tier
# DATABASE_URL=sqlite:////home/YOUR_PA_USERNAME/tdis/instance/tender.db

# ── Redis (Optional - PythonAnywhere doesn't include Redis) ───────────────────
# App falls back to in-memory cache if Redis unavailable
REDIS_URL=redis://localhost:6379/0

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_FOLDER=/home/YOUR_PA_USERNAME/tdis/uploads/
LOGS_FOLDER=/home/YOUR_PA_USERNAME/tdis/logs/
MAX_FILE_SIZE=52428800

# ── Mail (Update with your SMTP credentials) ──────────────────────────────────
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_EMAIL@tia-solutions.co.za
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD
MAIL_FROM=support@tia-solutions.co.za

# ── CORS (Update with your PythonAnywhere URL) ────────────────────────────────
CORS_ORIGINS=https://YOUR_PA_USERNAME.pythonanywhere.com

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_ASYNC=False
ENABLE_OCR=False
ENABLE_ML=False
LOG_LEVEL=INFO

# ── API Settings ──────────────────────────────────────────────────────────────
EXTRACTION_TIMEOUT=300
EXTRACTION_CONFIDENCE_THRESHOLD=0.7
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
