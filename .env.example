# Backend Environment Variables for TDIS

# ── Application ────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production

# ── Development Settings ───────────────────────────────────────────────────
# Set to 'true' to seed default test users (DEVELOPMENT ONLY)
# For production, leave this as 'false' and use create_admin.py script
SEED_DEFAULT_USERS=true

# ── Database ───────────────────────────────────────────────────────────────
# Development (SQLite)
# DATABASE_URL=sqlite:///instance/tender.db

# Production (PostgreSQL - provided by Render automatically)
# DATABASE_URL=postgresql://user:password@host:5432/database

# ── Redis Cache ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ───────────────────────────────────────────────────────────────────
# Development
CORS_ORIGINS=http://localhost:3000

# Production (comma-separated list)
# CORS_ORIGINS=https://your-frontend-domain.onrender.com,https://your-custom-domain.com

# ── File Upload ────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads/
LOGS_FOLDER=logs/
QUARANTINE_FOLDER=quarantine/
MAX_FILE_SIZE=524288000  # 500 MB in bytes

# ── File Security ──────────────────────────────────────────────────────────
ENABLE_FILE_MIME_VALIDATION=True
ENABLE_VIRUS_SCANNING=False  # Set to True if ClamAV is installed

# ── Feature Flags ──────────────────────────────────────────────────────────
ENABLE_ASYNC=False
ENABLE_OCR=False
ENABLE_ML=False

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_TO_STDOUT=True

# ── Email (Optional) ───────────────────────────────────────────────────────
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=noreply@yourdomain.com

# ── Extraction ─────────────────────────────────────────────────────────────
EXTRACTION_TIMEOUT=300  # seconds
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# ── Production Settings (Render) ───────────────────────────────────────────
# These are set automatically by Render:
# - DATABASE_URL (from PostgreSQL database)
# - REDIS_URL (from Redis service)
# - SECRET_KEY (auto-generated if set in render.yaml)
# - PORT (automatically set by Render)
